// schema.prisma - Cơ sở dữ liệu Web bán tài nguyên & Dịch vụ tài khoản số
// Hỗ trợ Đăng nhập Google (OAuth), Đặt hàng để lại SĐT liên hệ, và Phân quyền Admin quản trị

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 1. Phân quyền (Role-Based Access Control)
enum Role {
  USER       // Khách hàng (Đăng nhập Google, đặt hàng, xem đơn cá nhân)
  STAFF      // Nhân viên CSKH (Xem danh sách SĐT khách đặt, gọi điện tư vấn)
  ADMIN      // Quản trị viên tối cao (Thêm/Sửa/Xóa sản phẩm, cấu hình giá & tồn kho)
}

// 2. Trạng thái đơn đặt hàng (Luồng gọi điện tư vấn)
enum OrderStatus {
  PENDING_CONTACT // Khách vừa đặt hàng -> Chờ Shop gọi điện / nhắn Zalo
  CONTACTED       // Đã liên hệ trao đổi với khách
  COMPLETED       // Đã bàn giao tài khoản & hoàn tất
  CANCELLED       // Khách hủy hoặc không nghe máy
}

// 3. Bảng Người dùng (Tích hợp Google Login)
model User {
  id           String    @id @default(uuid())
  googleId     String?   @unique // ID tài khoản Google trả về khi đăng nhập
  email        String    @unique
  name         String?   // Tên hiển thị từ Google
  avatarUrl    String?   // Ảnh đại diện từ Google
  phone        String?   // Số điện thoại khách lưu
  role         Role      @default(USER)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  orders       Order[]
}

// 4. Danh mục (AI Tools, Đồ họa, Giải trí...)
model Category {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  products    Product[]
}

// 5. Sản phẩm (ChatGPT, Canva, CapCut, YouTube...)
model Product {
  id             String           @id @default(uuid())
  categoryId     String
  category       Category         @relation(fields: [categoryId], references: [id])
  name           String
  slug           String           @unique
  badge          String?          // VD: "BÁN CHẠY", "HOT", "BẢN QUYỀN"
  shortDesc      String           // Mô tả ngắn hiển thị ở trang chủ
  longDesc       String           @db.Text // Mô tả chi tiết & tính năng
  warrantyPolicy String           @db.Text // Quy định bảo hành chi tiết
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  variants       ProductVariant[]
}

// 6. Các gói của sản phẩm (VD: 1 Tháng, 1 Năm...)
model ProductVariant {
  id           String       @id @default(uuid())
  productId    String
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  title        String       // VD: "CHAT GPT PLUS 1M"
  price        Decimal      @db.Decimal(12, 2)
  oldPrice     Decimal?     @db.Decimal(12, 2)
  stock        Int          @default(10) // Số lượng tồn kho
  isContact    Boolean      @default(false) // Giá liên hệ hay giá cụ thể
  createdAt    DateTime     @default(now())

  orders       Order[]
}

// 7. Bảng Đơn đặt hàng (Lưu Số Điện Thoại & Ghi chú để Shop gọi lại)
model Order {
  id             String         @id @default(uuid())
  code           String         @unique // VD: ORD-9412
  userId         String?
  user           User?          @relation(fields: [userId], references: [id])
  variantId      String
  variant        ProductVariant @relation(fields: [variantId], references: [id])
  
  // Thông tin liên hệ khách để lại
  customerPhone  String         // SĐT bắt buộc để Shop liên hệ / Zalo
  customerName   String?
  customerEmail  String?
  customerNote   String?        @db.Text // Ghi chú (VD: gọi trước 12h, gửi qua Zalo...)
  
  price          Decimal        @db.Decimal(12, 2)
  status         OrderStatus    @default(PENDING_CONTACT)
  adminNote      String?        @db.Text // Ghi chú nội bộ của Admin khi gọi khách

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}
